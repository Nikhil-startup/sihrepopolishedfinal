# Neon Serverless PostgreSQL Database
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xxxx.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.neon.tech/neondb/auth/.well-known/jwks.json

# Live FastAPI Backend (Render / Railway)
NEXT_PUBLIC_API_URL=https://sihrepopolishedfinal.onrender.com
NEXT_PUBLIC_WS_URL=wss://sihrepopolishedfinal.onrender.com

# Cloudflare R2 Object Storage (Optional for Presigned Uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=agriflow-storage
R2_PUBLIC_DOMAIN=
